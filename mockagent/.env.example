A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=qwen-plus
A2AT_LLM_API_KEY=sk-xxx
A2AT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
A2AT_LLM_MAX_ATTEMPTS=2
A2AT_LANGUAGE=zh-CN
MOCK_AGENT_HOST=127.0.0.1
MOCK_AGENT_PORT=9000
MOCK_AGENT_DB_PATH=data/mockagent.db
# Leave blank for a process-local random key. Set a shared random key (32+ bytes) for multiple workers.
MOCK_AGENT_JWT_SECRET=
# JWT 有效期（分钟）
MOCK_AGENT_JWT_EXPIRE_MINUTES=720
MOCK_AGENT_ADMIN_PASSWORD=
MOCK_AGENT_PUBLIC_URL=http://203.0.113.20/debug/a2a
MOCK_AGENT_AGENT_INTERNAL_URL=http://127.0.0.1:9000/debug/a2a/message:send
MOCK_AGENT_STUB_FALLBACK=on
# 注册中心心跳上报（heartbeat.py）
MOCK_AGENT_REGISTRY_URL=http://127.0.0.1:5000
MOCK_AGENT_HEARTBEAT_ENABLED=on
# 初始上报周期（秒）；实际周期以注册中心心跳应答中的 interval 为准，±10% 抖动
MOCK_AGENT_HEARTBEAT_INTERVAL=30
# 上报身份 CN，必须与卡片在注册中心绑定的 owner 一致（owner.identity.mode=trusted_proxy）
MOCK_AGENT_HEARTBEAT_OWNER=mock-monitor
# 仅上报名称以该前缀开头的卡片（与 register_mockagents.py 注册范围一致）
MOCK_AGENT_HEARTBEAT_PREFIX=mockagent_
# 默认加载的 env 文件路径
MOCK_AGENT_ENV=.env
