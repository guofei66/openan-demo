A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=qwen-plus
A2AT_LLM_API_KEY=sk-xxx
A2AT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
A2AT_LLM_MAX_ATTEMPTS=2
A2AT_LANGUAGE=zh-CN
MOCK_AGENT_HOST=127.0.0.1
MOCK_AGENT_PORT=9000
MOCK_AGENT_DB_PATH=data/mockagent.db
MOCK_AGENT_JWT_SECRET=change-me-to-random
# JWT 有效期（分钟）
MOCK_AGENT_JWT_EXPIRE_MINUTES=720
MOCK_AGENT_ADMIN_PASSWORD=
MOCK_AGENT_PUBLIC_URL=http://203.0.113.20/debug/a2a
MOCK_AGENT_AGENT_INTERNAL_URL=http://127.0.0.1:9000/debug/a2a/message:send
MOCK_AGENT_STUB_FALLBACK=on
# 默认加载的 env 文件路径
MOCK_AGENT_ENV=.env
